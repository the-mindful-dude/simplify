{
  "name": "@simplify-dev/cli",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "simplify": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config ../../vitest.shared.ts --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@simplify-dev/registry": "workspace:*",
    "@simplify-dev/tooling": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
