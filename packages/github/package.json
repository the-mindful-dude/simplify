{
  "name": "@simplify-dev/github",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config ../../vitest.shared.ts --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.1",
    "@octokit/oauth-methods": "^6.0.5",
    "@octokit/rest": "^22.0.1",
    "@simplify-dev/schemas": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
