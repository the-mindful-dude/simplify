{
  "name": "simplify",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --config vitest.shared.ts && turbo run test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "docker:build": "docker compose build web",
    "docker:up": "docker compose up --build web",
    "docker:down": "docker compose down",
    "docker:dev": "docker compose --profile dev up --build web-dev",
    "dev:webhooks": "pnpm --filter @simplify-dev/registry-api dev",
    "webhook:tunnel": "node --env-file=.env.local scripts/dev/webhook-tunnel.mjs",
    "webhook:send": "node --env-file=.env.local scripts/dev/send-webhook.mjs"
  },
  "overrides": {
    "@octokit/request": "^9.4.0"
  },
  "pnpm": {
    "overrides": {
      "@octokit/request>content-type": "2.1.0"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.17.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turbo": "^2.11.13",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^2.1.8"
  }
}
