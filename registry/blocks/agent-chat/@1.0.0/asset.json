{
  "schemaVersion": 1,
  "id": "blocks/agent-chat",
  "category": "blocks",
  "name": "Agent Chat",
  "description": "Reusable agent conversation interfaces and logic.",
  "version": "1.0.0",
  "publisher": "simplify.dev",
  "status": "official",
  "license": "MIT",
  "targets": [{ "language": "typescript", "framework": "react", "runtime": "browser" }],
  "implementations": [
    {
      "id": "react",
      "target": { "language": "typescript", "framework": "react", "runtime": "browser" },
      "mode": "source",
      "entry": "src/agent-chat.tsx"
    }
  ],
  "dependencies": {
    "registry": [
      { "id": "ui/button", "version": "1.0.0" },
      { "id": "ui/input", "version": "1.0.0" }
    ],
    "packages": [
      { "name": "react", "version": "^18.3.1", "kind": "peer" },
      { "name": "react-dom", "version": "^18.3.1", "kind": "peer" }
    ]
  },
  "installation": {
    "modes": [
      {
        "mode": "source",
        "files": [
          { "source": "src/agent-chat.tsx", "target": "src/components/blocks/agent-chat.tsx" }
        ]
      }
    ]
  },
  "documentation": {
    "readme": "README.md",
    "examples": ["examples/basic.tsx"],
    "changelog": "CHANGELOG.md"
  }
}
