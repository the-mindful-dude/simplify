# Copy to .env.local for local development or .env for container runs.
# Never commit real credentials or environment values.

# Runtime
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0

# Next.js
NEXT_TELEMETRY_DISABLED=1

# GitHub App integration (never commit real credentials or private keys)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# Registry API
REGISTRY_API_PORT=3002
