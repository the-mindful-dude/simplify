# simplify.dev — local environment template (authoritative)
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` at the REPOSITORY ROOT, then fill in only what
# you need:
#
#   cp .env.example .env.local
#
# `.env.local` is ignored by Git (`.gitignore` rule `.env*.local`). Never commit
# real values. Node 20 reads this file directly through `--env-file`, so no
# dotenv dependency is required.
#
# ─────────────────────────────────────────────────────────────────────────────
# WHICH VALUES DO I NEED?
#
# Webhook-only local testing (signed payloads, no GitHub credentials):
#   GITHUB_APP_WEBHOOK_SECRET   REQUIRED — fixture value is fine; the sender
#                               must use the exact same value.
#   REGISTRY_API_PORT / HOSTNAME  optional (defaults below)
#   WEBHOOK_PUBLIC_URL          optional — printed by the tunnel harness.
#
# Full GitHub App flows (auth, repository APIs, publishing):
#   All five required GITHUB_APP_* variables below, plus GITHUB_APP_SLUG
#   (optional). Leave them empty for webhook-only local testing.
# ---------------------------------------------------------------------------

# ─── Runtime ────────────────────────────────────────────────────────────────
# NODE_ENV — runtime mode. Use "development" locally.
NODE_ENV=development

# PORT — HTTP port read by the registry-api server when no override applies.
# The dev/start scripts align it to REGISTRY_API_PORT, so leave this at its
# default and change REGISTRY_API_PORT instead if you need a different port.
PORT=3000

# HOSTNAME — bind address for the registry-api HTTP server. 0.0.0.0 is local-only
# safe here; do not expose it publicly without authentication.
HOSTNAME=0.0.0.0

# ─── Next.js ────────────────────────────────────────────────────────────────
# NEXT_TELEMETRY_DISABLED — opt out of Next.js telemetry locally.
NEXT_TELEMETRY_DISABLED=1

# ─── Registry API + local tunnel ────────────────────────────────────────────
# REGISTRY_API_PORT — port the registry-api listens on locally and the port the
# Cloudflare quick-tunnel harness forwards to. Default: 3002.
REGISTRY_API_PORT=3002

# WEBHOOK_PUBLIC_URL — public base URL printed by `pnpm webhook:tunnel`
# (for example https://abcd-1234.trycloudflare.com). Nothing reads this
# automatically; copy it into GitHub App → Settings → Webhook URL as
#   <WEBHOOK_PUBLIC_URL>/webhooks/github
# and into the signed-request helper when targeting the public URL.
WEBHOOK_PUBLIC_URL=

# WEBHOOK_SENDER_MODULE — OPTIONAL override for the signed-request helper's
# implementation module. Defaults to
# apps/registry-api/dist/dev/send-webhook.js relative to the repository root.
WEBHOOK_SENDER_MODULE=

# ─── GitHub App credentials ─────────────────────────────────────────────────
# Source for every value below: GitHub → Settings → Developer settings →
# GitHub Apps → <your app>. NEVER commit real values. Required only for full
# GitHub App flows; webhook-only local testing needs just the webhook secret.

# GITHUB_APP_ID — the numeric "App ID" shown at the top of the app's settings
# page. Full flows only. Must be a positive integer.
GITHUB_APP_ID=

# GITHUB_APP_PRIVATE_KEY — contents of the private key (.pem) generated under
# the app's "Private keys" section. Keep it on ONE line: replace every real
# newline with the two characters \n (backslash + n). The loader converts
# them back with `.replace(/\\n/g, '\n')` (packages/github/src/config.ts:48).
# Full flows only.
GITHUB_APP_PRIVATE_KEY=

# GITHUB_APP_CLIENT_ID — the "Client ID" on the app's settings page.
# Full flows only.
GITHUB_APP_CLIENT_ID=

# GITHUB_APP_CLIENT_SECRET — generated under the app's "Client secrets".
# Full flows only. Never commit.
GITHUB_APP_CLIENT_SECRET=

# GITHUB_APP_WEBHOOK_SECRET — the "Webhook secret" configured on the GitHub App.
# REQUIRED for webhook-only local testing: the receiver verifies the
# X-Hub-Signature-256 header with this value. For local-only fixture tests use
# any throwaway value, provided the sender uses the exact same value. For real
# GitHub deliveries it MUST match the App's configured webhook secret.
GITHUB_APP_WEBHOOK_SECRET=

# GITHUB_APP_SLUG — OPTIONAL URL slug of the GitHub App. Used for display/links
# only; safe to leave empty.
GITHUB_APP_SLUG=

# Docker Compose passes all five required variables into `registry-api` by
# interpolation from this file/environment; no values are stored in
# docker-compose.yml. For full GitHub App flows you may instead give that
# service a dedicated `env_file` containing these keys — keep such a file out
# of Git. Webhook-only local testing works with just GITHUB_APP_WEBHOOK_SECRET.
